# Leave empty to disable login (LAN-only trust).
APP_PASSWORD=

# UDP broadcast target for magic packets.
WOL_BROADCAST=255.255.255.255

# SQLite + settings directory inside the container.
DATA_DIR=/var/www/html/data

# Nginx listen port (host networking shares the host port namespace).
HTTP_PORT=9080

# Public URL prefix. Leave unset to auto-detect.
# Use empty (BASE_PATH=) when a reverse proxy serves the app at domain root
# (e.g. https://wol.example.com → http://web01/wol/).
# BASE_PATH=
